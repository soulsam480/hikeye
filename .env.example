# Camera connection (required)
STREAM_IP=192.168.0.100
STREAM_USER=admin
STREAM_PASS=change-me

# Cameras: channel:name, comma separated. Channel 1 -> 102 (sub stream).
# CAMERAS=1:Front Door,2:Backyard,3:Garage,4:Driveway,5:Side,6:Porch,7:Office

# decrypt = encrypted Hikvision streams (H.264 only)
# rtsp    = unencrypted RTSP
# snapshot = poll ISAPI JPEGs (fallback)
STREAM_MODE=decrypt

# The verification code is read from the DVR automatically with an admin
# account. Set it here only if that fails.
# STREAM_SECRET_KEY=

# Single-camera options (ignored when CAMERAS is set)
# CAMERA_NAME=Front Camera
# STREAM_PATH=/Streaming/Channels/102
# STREAM_PORT=554
# STREAM_TRANSPORT=tcp

# Dashboard
PORT=8080
# 127.0.0.1 = this machine only. Use 0.0.0.0 to view from your phone.
HOST=127.0.0.1
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=

# Capture tuning
# STREAM_FPS=10
# STREAM_QUALITY=5
# SNAPSHOT_FPS=2

# RECORDINGS_DIR=recordings
# FFMPEG_PATH=ffmpeg
